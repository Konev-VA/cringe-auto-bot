BOT_TOKEN=0000000000:replace_me
CHROME_PATH=/usr/bin/chromium
FETCH_TIMEOUT=60s
LOG_LEVEL=info
# необязательно: IP api.telegram.org через запятую, если DNS отдаёт заблокированные
TELEGRAM_IPS=
# прокси для площадок (avito.ru блокирует зарубежные адреса, farpost.ru и baza.drom.ru
# могут отдавать проверку браузера), напр. socks5://host:1080
AVITO_PROXY=
